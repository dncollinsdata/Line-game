{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "../.levelgen",
    "rootDir": ".."
  },
  "include": ["../engine/**/*.ts", "./*.ts"],
  "exclude": ["../engine/__tests__"]
}
