{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "../.levelgen",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": [
    "../engine/**/*.ts",
    "../lib/logSummary.ts",
    "../lib/eventLog.ts",
    "./*.ts"
  ],
  "exclude": [
    "../engine/__tests__"
  ]
}
